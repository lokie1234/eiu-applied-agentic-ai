# Supabase / PDF storage
NEXT_PUBLIC_PDF_URL=https://your-project.supabase.co/storage/v1/object/public/presentations/your-file.pdf

# Supabase interactive backend
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Server-only passcode session signing secret (at least 32 random characters).
PASSCODE_SESSION_SECRET=replace_with_a_long_random_secret




# Gemini AI (Private Knowledge AI module)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Optional: pre-existing File Search Store name (if not set, the app creates one automatically)
# GEMINI_FILE_SEARCH_STORE=fileSearchStores/your-store-id

