# Supabase / PDF storage
NEXT_PUBLIC_PDF_URL=https://your-project.supabase.co/storage/v1/object/public/presentations/your-file.pdf

# Supabase interactive backend
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Email OTP is delivered through the Custom SMTP provider configured in Supabase.
# SMTP credentials stay in Supabase Dashboard and are not Vercel environment variables.

# Server-only admin quick login code. Set this only in .env.local and Vercel secrets.
# Never commit the real code to Git.
ADMIN_QUICK_LOGIN_CODE=replace_with_a_private_code

# Gemini AI (Private Knowledge AI module)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# Optional: pre-existing File Search Store name (if not set, the app creates one automatically)
# GEMINI_FILE_SEARCH_STORE=fileSearchStores/your-store-id

