# Admin Direct Access Passcode
ADMIN_ACCESS_PASSWORD="your_admin_access_password_here"

# Gemini AI (Private Knowledge AI module)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"

# Google Drive Integration & OAuth
GOOGLE_DRIVE_ACCOUNT_EMAIL="admin@eiu.edu.vn"
GOOGLE_DRIVE_CLIENT_ID="your_google_drive_client_id.apps.googleusercontent.com"
GOOGLE_DRIVE_CLIENT_SECRET="your_google_drive_client_secret"
GOOGLE_DRIVE_PICKER_API_KEY="your_google_drive_picker_api_key"
GOOGLE_DRIVE_REDIRECT_URI="http://localhost:3000/api/admin/drive/callback"

# Supabase Interactive Backend
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
SUPABASE_SECRET_KEY="sb_secret_your_secret_here"

# Server-only session signing secret (at least 32 characters)
PASSCODE_SESSION_SECRET="your_passcode_session_secret_at_least_32_chars"

# Vercel OIDC Token (generated automatically by Vercel CLI if linked)
VERCEL_OIDC_TOKEN="your_vercel_oidc_token_here"
