# Self-contained lesson files are downloadable byte-preserving artifacts.
course-content/**/*.js -text
lib/drive/builtin-decks/*.js -text

# Preserve the original classroom downloads across Windows/Linux checkouts.
course-content/mis301/*.ipynb -text
course-content/mis301/*.csv -text

# Embedded text assets must have identical downloadable bytes on every OS.
public/branding/apps/*.svg text eol=lf
public/downloads/*.txt text eol=lf
public/downloads/dynamic-sheet-dashboard/SKILL.md text eol=lf
assets/emergency/SKILL.md text eol=lf
