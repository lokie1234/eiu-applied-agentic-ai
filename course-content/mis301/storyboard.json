    {
      "kind": "sources",
      "phase": "DATA SOURCES",
      "title": "Data comes from many sources",
      "subtitle": "",
      "sources": [
        {
          "title": "Local files",
          "icon": "file",
          "bullets": [
            "Files on your computer.",
            "Flat files or spreadsheets."
          ],
          "formats": [
            {
              "id": "csv",
              "label": "CSV",
              "title": "CSV: values separated by commas",
              "inputLabel": "scores.csv",
              "input": "student,score\nAn,85\nBinh,92\nChi,78",
              "previewTitle": "The same records as a table",
              "differenceTitle": "One line = one row",
              "difference": "Commas separate fields. The first line supplies column names; CSV stores a plain-text table without sheets or cell formatting."
            },
            {
              "id": "txt",
              "label": "TXT",
              "title": "TXT: plain text without a fixed table",
              "inputLabel": "scores.txt",
              "input": "An scored 85.\nBinh scored 92.\nChi scored 78.",
              "previewTitle": "Text rather than table cells",
              "differenceTitle": "No required row/column structure",
              "difference": "A .txt file can contain prose or delimiter-separated records. This example uses sentences, so student and score must be extracted first."
            },
            {
              "id": "xlsx",
              "label": "XLSX",
              "title": "XLSX: cells inside a workbook",
              "inputLabel": "scores.xlsx",
              "input": "",
              "previewTitle": "Worksheet: Scores",
              "differenceTitle": "A workbook can contain several sheets",
              "difference": "Each value occupies an addressed cell, such as A2 or B2. XLSX can store multiple worksheets, formulas and formatting; CSV cannot."
            }
          ]
        },
        {
          "title": "Databases",
          "icon": "database",
          "bullets": [
            "Query stored data.",
            "SQL tables or NoSQL documents."
          ],
          "formats": [
            {
              "id": "sql",
              "label": "SQL",
              "title": "SQL: a table in a relational database",
              "inputLabel": "Table + query",
              "input": "CREATE TABLE scores (\n  student TEXT,\n  score INTEGER\n);\n\nSELECT student, score\nFROM scores\nORDER BY student;",
              "previewTitle": "Query result: scores",
              "differenceTitle": "Defined columns; query the rows you need",
              "difference": "The table defines field types. SQL can select, filter and join stored tables. It is a database query language, rather than a flat-file format."
            },
            {
              "id": "nosql",
              "label": "NoSQL",
              "title": "NoSQL: a collection of documents",
              "inputLabel": "Collection: scores",
              "input": "{ \"_id\": \"s1\", \"student\": \"An\",\n  \"result\": { \"score\": 85 } }\n\n{ \"_id\": \"s2\", \"student\": \"Binh\",\n  \"result\": { \"score\": 92 } }\n\n{ \"_id\": \"s3\", \"student\": \"Chi\",\n  \"result\": { \"score\": 78 } }",
              "previewTitle": "Three separate stored documents",
              "differenceTitle": "Document example of a NoSQL database",
              "difference": "Related values can be nested inside one document. NoSQL is a database family, not a file format; document stores are one common type."
            }
          ]
        },
        {
          "title": "Web access",
          "icon": "web",
          "bullets": [
            "Data from the web.",
            "Website tables or API responses."
          ],
          "formats": [
            {
              "id": "html",
              "label": "HTML",
              "title": "HTML: a table inside a web page",
              "inputLabel": "scores.html",
              "input": "<table>\n  <tr><th>Student</th><th>Score</th></tr>\n  <tr><td>An</td><td>85</td></tr>\n  <tr><td>Binh</td><td>92</td></tr>\n  <tr><td>Chi</td><td>78</td></tr>\n</table>",
              "previewTitle": "What the browser displays",
              "differenceTitle": "Tags describe page content",
              "difference": "The browser renders <table>, <tr> and <td> as a visible table. Web scraping extracts values from this page structure."
            },
            {
              "id": "json",
              "label": "JSON",
              "title": "JSON: records described with keys",
              "inputLabel": "API response: JSON",
              "input": "[\n  {\"student\": \"An\", \"score\": 85},\n  {\"student\": \"Binh\", \"score\": 92},\n  {\"student\": \"Chi\", \"score\": 78}\n]",
              "previewTitle": "Records interpreted as a table",
              "differenceTitle": "Keys identify each value",
              "difference": "Objects use key/value pairs; arrays group records. JSON is common in APIs and supports nested objects, arrays and typed values."
            },
            {
              "id": "xml",
              "label": "XML",
              "title": "XML: records wrapped in named tags",
              "inputLabel": "API response: XML",
              "input": "<scores>\n  <record><student>An</student>\n    <score>85</score></record>\n  <record><student>Binh</student>\n    <score>92</score></record>\n  <record><student>Chi</student>\n    <score>78</score></record>\n</scores>",
              "previewTitle": "Records interpreted as a table",
              "differenceTitle": "Opening and closing tags carry structure",
              "difference": "Each record is enclosed by named tags. XML can also use attributes; extract the student and score elements to produce rows."
            }
          ]
        }
      ]
    },
